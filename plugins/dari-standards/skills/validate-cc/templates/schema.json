{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dari-standards Validate Result",
  "description": "Schema for .ww-w-ai/standards/validate-cc/latest.json -- CC configuration quality validation result",
  "type": "object",
  "required": ["version", "plugin", "skill", "project", "timestamp", "summary", "categories"],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "plugin": { "type": "string", "const": "standards" },
    "skill": { "type": "string", "const": "validate-cc" },
    "project": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "summary": {
      "type": "object",
      "required": ["total", "passed", "warnings", "failures", "grade"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "failures": { "type": "integer", "minimum": 0 },
        "grade": { "type": "string", "enum": ["Excellent", "Good", "Needs Improvement", "Poor"] }
      }
    },
    "categories": {
      "type": "array",
      "description": "Includes only categories present in the project",
      "items": {
        "type": "object",
        "required": ["name", "items"],
        "properties": {
          "name": { "type": "string", "description": "Category name (CLAUDE.md, Rules, Skills, Agents, Settings, README.md, Commands)" },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "status"],
              "properties": {
                "name": { "type": "string" },
                "status": { "type": "string", "enum": ["pass", "warn", "fail", "not_applicable", "shallow"] },
                "detail": { "type": "string" },
                "evidence": { "type": "string", "description": "One-line summary of the verification performed (tools, file count, patterns)" },
                "checkedCount": { "type": "integer" },
                "compliantCount": { "type": "integer" }
              }
            }
          }
        }
      }
    }
  }
}
