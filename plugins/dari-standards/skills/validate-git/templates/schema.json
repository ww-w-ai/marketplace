{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dari-standards Validate-Git Result",
  "description": "Schema for .ww-w-ai/standards/validate-git/latest.json -- Git rule compliance validation result",
  "type": "object",
  "required": ["version", "plugin", "skill", "project", "timestamp", "summary", "findings"],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "plugin": { "type": "string", "const": "standards" },
    "skill": { "type": "string", "const": "validate-git" },
    "project": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "summary": {
      "type": "object",
      "required": ["total", "passed", "warnings", "failures", "grade"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "failures": { "type": "integer", "minimum": 0 },
        "grade": { "type": "string", "enum": ["Excellent", "Good", "Needs Improvement", "Poor"] }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "type", "status"],
        "properties": {
          "file": { "type": "string", "description": "branch name, commit hash, or .git" },
          "type": { "type": "string", "enum": ["BRANCH", "COMMIT_MESSAGE", "SECRET_FILE"] },
          "status": { "type": "string", "enum": ["pass", "warn", "fail", "not_applicable", "shallow"] },
          "detail": { "type": "string" },
          "evidence": { "type": "string", "description": "One-line summary of the verification performed" }
        }
      }
    }
  }
}
