{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dari-standards Comprehensive Audit Result",
  "description": "Schema for .ww-w-ai/standards/audit/latest.json -- comprehensive project audit result with rich improvement context",
  "type": "object",
  "required": ["version", "project", "timestamp", "summary", "categories", "findings", "skippedSkills"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Schema version (semver)",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "project": {
      "type": "string",
      "description": "Project root directory name"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of the audit run"
    },
    "summary": {
      "type": "object",
      "required": ["total", "passed", "warnings", "failures", "grade"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "failures": { "type": "integer", "minimum": 0 },
        "grade": {
          "type": "string",
          "enum": ["Excellent", "Good", "Needs Improvement", "Poor"]
        },
        "expectedGrade": {
          "type": "string",
          "enum": ["Excellent", "Good", "Needs Improvement", "Poor"],
          "description": "Expected grade after all improvements are applied"
        },
        "skillsExecuted": {
          "type": "array",
          "description": "Names of executed skills",
          "items": { "type": "string" }
        },
        "skillsSkipped": {
          "type": "array",
          "description": "Names of skipped skills",
          "items": { "type": "string" }
        }
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "priority", "items"],
        "properties": {
          "name": { "type": "string" },
          "priority": { "type": "integer", "minimum": 1 },
          "expectedChange": {
            "type": "string",
            "description": "Summary of expected status change (e.g., '4 failures -> 0 failures')"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "status"],
              "properties": {
                "name": { "type": "string" },
                "status": { "type": "string", "enum": ["pass", "warn", "fail", "not_applicable", "shallow"] },
                "detail": { "type": "string" },
                "evidence": { "type": "string", "description": "One-line summary of the verification performed" },
                "checkedCount": { "type": "integer", "description": "Number of entities checked" },
                "compliantCount": { "type": "integer", "description": "Number of compliant entities" },
                "depthProof": { "type": "string", "description": "Proof of full execution depth (SKILL.md read: Y/N, all criteria: Y/N)" }
              }
            }
          },
          "entityTable": {
            "type": "array",
            "description": "Per-entity recommendation matrix (e.g., tools per agent, mappings per skill)",
            "items": {
              "type": "object",
              "required": ["entityName"],
              "additionalProperties": { "type": "string" },
              "properties": {
                "entityName": { "type": "string" }
              }
            }
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["description", "impact"],
              "properties": {
                "description": { "type": "string" },
                "impact": { "type": "string", "description": "Status change (e.g., FAIL -> PASS)" },
                "reference": { "type": "string", "description": "Rule file path" },
                "ruleSection": { "type": "string", "description": "Specific section (e.g., 'section 2')" },
                "evidenceType": {
                  "type": "string",
                  "enum": ["CC_OFFICIAL", "CC_SCHEMA", "ANTHROPIC_DOCS", "INDUSTRY_STD", "EMPIRICAL"]
                },
                "severity": {
                  "type": "string",
                  "enum": ["required", "recommended"],
                  "description": "required = FAIL item, recommended = WARN item"
                },
                "codeExample": {
                  "type": "string",
                  "description": "Multi-line fenced code block content (Markdown)"
                },
                "before": {
                  "type": "string",
                  "description": "Current-state snippet for before/after comparison"
                },
                "after": {
                  "type": "string",
                  "description": "Improved-state snippet for before/after comparison"
                },
                "riskDescription": {
                  "type": "string",
                  "description": "Risk description for the current state"
                },
                "richContent": {
                  "type": "string",
                  "description": "Pre-formatted Markdown for complex content (tables, diagrams, etc.)"
                }
              }
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "description": "Finding-based results from validate-docs, validate-git, scan-security, validate-architecture, validate-tests",
      "items": {
        "type": "object",
        "required": ["skill", "file", "type", "status"],
        "properties": {
          "skill": { "type": "string", "description": "Source skill name" },
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "type": { "type": "string", "description": "Finding type (e.g., TODO_FORMAT, HARDCODED_SECRET, LAYER_VIOLATION)" },
          "severity": { "type": "string", "description": "Severity (CRITICAL, HIGH, MEDIUM, ERROR, WARN)" },
          "status": { "type": "string", "enum": ["pass", "warn", "fail"] },
          "detail": { "type": "string" }
        }
      }
    },
    "skippedSkills": {
      "type": "array",
      "description": "Skills that were discovered but not executed",
      "items": {
        "type": "object",
        "required": ["skill", "reason"],
        "properties": {
          "skill": { "type": "string" },
          "plugin": { "type": "string", "description": "Plugin the skill belongs to (standards or devtools)" },
          "reason": { "type": "string", "description": "Reason the skill was skipped" }
        }
      }
    },
    "improvementPriority": {
      "type": "array",
      "description": "Consolidated improvement actions sorted by priority across all skills",
      "items": {
        "type": "object",
        "required": ["priority", "severity", "category", "description", "source"],
        "properties": {
          "priority": { "type": "integer", "minimum": 1, "description": "Priority rank (1 = highest)" },
          "severity": { "type": "string", "description": "Severity (CRITICAL, HIGH, ERROR, WARN)" },
          "category": { "type": "string", "description": "Category or domain name" },
          "description": { "type": "string", "description": "Summary description of the issue" },
          "source": { "type": "string", "description": "Source skill name" }
        }
      }
    }
  }
}
