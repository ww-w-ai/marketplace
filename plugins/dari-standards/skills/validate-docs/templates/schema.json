{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dari-standards Validate-Docs Result",
  "description": "Schema for .ww-w-ai/standards/validate-docs/latest.json -- code documentation quality validation result",
  "type": "object",
  "required": ["version", "plugin", "skill", "project", "timestamp", "summary", "findings"],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "plugin": { "type": "string", "const": "standards" },
    "skill": { "type": "string", "const": "validate-docs" },
    "project": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "summary": {
      "type": "object",
      "required": ["total", "passed", "warnings", "failures", "grade"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "failures": { "type": "integer", "minimum": 0 },
        "grade": { "type": "string", "enum": ["Excellent", "Good", "Needs Improvement", "Poor"] }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "type", "status"],
        "properties": {
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "type": { "type": "string", "enum": ["TODO_FORMAT", "HACK_CONDITION", "OBVIOUS_COMMENT"] },
          "status": { "type": "string", "enum": ["pass", "warn", "not_applicable", "shallow"] },
          "detail": { "type": "string" },
          "evidence": { "type": "string", "description": "One-line summary of the verification performed" }
        }
      }
    },
    "prefixSummary": {
      "type": "array",
      "description": "Semantic prefix usage counts (informational only)",
      "items": {
        "type": "object",
        "required": ["prefix", "count"],
        "properties": {
          "prefix": { "type": "string", "enum": ["WHY", "CONSTRAINT", "DEPENDS", "SECURITY", "PERF", "MIGRATION"] },
          "count": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
